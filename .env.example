# Copy this to .env and fill in values
# Docker Compose uses these automatically

# Local Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_scanner

# For Railway - set this in the Railway dashboard, not here
# DATABASE_URL=postgresql+asyncpg://...  (Railway auto-injects this)

# Optional: path to the YAML tool database
# Defaults to ../data/tools relative to the backend
TOOL_DB_PATH=../data/tools
